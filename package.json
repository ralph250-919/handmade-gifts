{
  "name": "handmade-gifts",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless online shop for hand-created gifts on AWS with Stripe Checkout and CloudWatch monitoring.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "tsx scripts/dev-server.ts",
    "synth": "cdk synth --quiet",
    "deploy": "cdk deploy",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-lambda-powertools/metrics": "^2.36.0",
    "@aws-lambda-powertools/tracer": "^2.36.0",
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@aws-sdk/client-sesv2": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1147.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
